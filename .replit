run = "cd web-app/backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"

[nix]
channel = "stable-24_05"

[deployment]
build = ["sh", "-c", "pip install -r web-app/backend/requirements.txt && cd web-app/frontend && npm install && npm run build"]
run = ["sh", "-c", "cd web-app/backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"]

[[ports]]
localPort = 8000
externalPort = 80
